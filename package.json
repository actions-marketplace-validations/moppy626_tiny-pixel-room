{
  "name": "tiny-pixel-room",
  "version": "1.0.0",
  "description": "GitHub プロフィールに、育つドット絵のおへやを飾る GitHub Action",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "scripts": {
    "test": "node --test test/*.test.mjs",
