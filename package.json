    "samples": "node scripts/samples.mjs",
    "card": "node src/cli.mjs",
    "site": "node scripts/build-site.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "opentype.js": "^2.0.0"
  }
}
